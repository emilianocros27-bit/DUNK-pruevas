rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso del juego: solo tu propia cuenta
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfiles: cualquiera autenticado puede VER, solo el dueño edita
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // @usuarios: cualquiera autenticado puede buscar (leer).
    // Crear: solo si reclamas tu propio uid. No se puede pisar el de otro.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Amistades: solo los dos implicados pueden leer/escribir
    match /friendships/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Intercambios: solo los implicados (campo parties = [from, to])
    match /trades/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.parties;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.parties;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.parties;
    }

    // Clasificación del minijuego: tabla pública; cada quien escribe solo su récord.
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Fantasy: temporada compartida (mapa equipo->dueño), calendario por equipo y partidos.
    // Todo autenticado puede leer/reclamar equipo, pero solo el comisionado puede arrancar el reloj
    // (cambiar started/startedAt/endsAt) — así el dueño de la cuenta decide cuándo inicia.
    match /fantasySeason/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.resource.data.started == resource.data.started
         || request.auth.token.email == "emilianocros27@gmail.com");
    }
    match /fantasySchedules/{team} {
      allow read, write: if request.auth != null;
    }
    match /fantasyGames/{id} {
      allow read, write: if request.auth != null;
    }
    match /fantasyLineups/{team} {
      allow read, write: if request.auth != null;
    }
    // Ofertas de mercado: cualquiera autenticado crea la suya; solo el comisionado puede
    // aceptar/rechazar (cambia el status), vía Claude en el chat.
    match /fantasyTrades/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.email == "emilianocros27@gmail.com";
      allow delete: if false;
    }
    // Buzón privado de avisos de Fantasy (ej. "se aceptó tu oferta"): el comisionado los crea,
    // cada quien solo puede leer/marcar-leído los suyos.
    match /fantasyInbox/{id} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null && request.auth.token.email == "emilianocros27@gmail.com";
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid
                    && request.resource.data.toUid == resource.data.toUid;
      allow delete: if false;
    }
    // Noticias de la temporada: cualquiera autenticado puede leer; publicarlas las hace el comisionado
    // (el dueño de la cuenta, vía Claude) — no hay UI de redactar dentro del juego.
    match /fantasyNews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Códigos de un solo uso: cualquiera autenticado los genera/lee;
    // reclamar = pasar used de false a true (una sola vez).
    match /codes/{code} {
      allow get, create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.used == false
                    && request.resource.data.used == true;
      allow delete: if false;
    }
  }
}
